#
# from device/amazon/rhodes/system.prop
#
# Default value of (persist.sys.boot.reason) after first flash boot OR
# first boot after factory reset in /system/build.prop
persist.sys.boot.reason="reboot,"
persist.sys.bootanim.boot.reason="reboot,"

## First time no bootanimation audio after full flash or factory reset
# Use non-zero default volume for system stream to ensure audio is not muted
# when boot animation starts before the AudioService (SystemServer) initializes
# Rhodes SystemServer init for first boot takes longer time and AudioService
# full init is block on that.
# Should match below default index for AUDIO_STREAM_SYSTEM for AUDIO_DEVICE_OUT_SPEAKER
# https://grok-fireos.labcollab.net/fireos_main_pie/xref/vendor/amazon/audio/config/rhodes/audio_policy_volumes.xml?r=7c96297d#38
ro.config.system_vol_default=12
ro.config.system_vol_steps=30

# Allow boosting of CPUs up to fifteen seconds.
persist.perfboost.time=15000

# PlayReady_3 DRM LPKB location
ro.amzn_drm.pr3_file=/data/vendor/mediadrm/playready/playready.hds

# Reserve WHA server ports.
sys.sysctl.ip_loc_res_ports=55442-55445

#enable OTA download via metered network
persist.sys.ota_allow_metered=true

# Storage
ro.storaged.event.interval=999999

# Use this property to configure AudioFlinger to choose the Normal mixer path
# when the HAL buffer size is more than or equal to the size mentioned
audio.af.min.normalsink.bufsize.ms=16

## Overriding package name which is used for OTA package
ro.product.device.shared.ota=rhodes

# gralloc optimization
ro.fos.gralloc.flags=0x00000200

# maximum backup size for factory reset allowlist in kB
ro.recovery.wl.maxstore=524288

