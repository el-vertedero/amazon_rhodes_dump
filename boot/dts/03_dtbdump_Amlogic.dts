			gpios = <0x25 0x8a 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x73>;
			phandle = <0xa1>;
		};

		volume2 {
			label = "Volume button 2";
			debounce-interval = <0x14>;
			gpios = <0x25 0x89 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x72>;
			phandle = <0x9f>;
		};

		camera_lens_cover {
