/dts-v1/;

/ {
	model = "Amlogic";
	amlogic-dt-id = "t7_rhodes_hvt";
	compatible = "amlogic, t7";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	amic-remap = <0x00 0x02 0x01 0x03>;
	dmic-remap = <0x02 0x00 0x01 0x03>;

	custom_maps {
		mapnum = <0x03>;
		map0 = <0x02>;
		map1 = <0x03>;
		map2 = <0x04>;
		phandle = <0x60>;

		map_0 {
			mapname = "amlogic-remote-1";
			customcode = <0xfb04>;
			release_delay = <0x50>;
			size = <0x33>;
			keymap = <0x47000b 0x130002 0x100003 0x110004 0xf0005 0xc0006 0xd0007 0xb0008 0x80009 0x9000a 0x5c0061 0x51003d 0x50003e 0x40003f 0x4d0040 0x430041 0x170042 0x43 0x10044 0x160057 0x49000e 0x60082 0x140083 0x440067 0x1d006c 0x1c0069 0x48006a 0x53007d 0x450068 0x19006d 0x520077 0x5007a 0x59007b 0x1b0078 0x40079 0x1a0074 0xa000f 0xe0071 0x1f0066 0x1e0084 0x70085 0x120086 0x540087 0x20088 0x4f001e 0x420030 0x5d002e 0x4c0020 0x580089 0x1500d9 0x55008c>;
			phandle = <0x02>;
		};

		map_1 {
			mapname = "amlogic-remote-2";
			customcode = <0xfe01>;
			release_delay = <0x50>;
			size = <0x35>;
			keymap = <0x10002 0x20003 0x30004 0x40005 0x50006 0x60007 0x70008 0x80009 0x9000a 0xa000b 0x1f01d2 0x15008b 0x16000f 0xc0192 0xd0193 0xe0073 0xf0072 0x110066 0x1c006a 0x1b0069 0x190067 0x1a006c 0x1d001c 0x170071 0x4900db 0x43009e 0x1201d5 0x1401d6 0x1801d7 0x590166 0x5a00a6 0x100074 0x4200a5 0x4400a3 0x1e00a8 0x4b00d0 0x5800a4 0x460082 0x400083 0x380046 0x5701d0 0x5b01d1 0x54018e 0x4c018f 0x4e0190 0x550191 0x5300ed 0x5200ee 0x3900d4 0x4100d5 0xb00d6 0xd8 0x1300d9>;
			phandle = <0x03>;
		};

		map_2 {
			mapname = "amlogic-remote-3";
			customcode = <0xbd02>;
			release_delay = <0x50>;
			size = <0x11>;
			keymap = <0xca0067 0xd2006c 0x990069 0xc1006a 0xce0061 0x450074 0xc50085 0x800071 0xd0000f 0xd6007d 0x950066 0xdd0068 0x8c006d 0x890083 0x9c0082 0x9a0078 0xcd0079>;
			phandle = <0x04>;
		};
	};

	bifrost {
		compatible = "arm,malit60x\0arm,malit6xx\0arm,mali-midgard";
		#cooling-cells = <0x02>;
		reg = <0x00 0xfe400000 0x00 0x4000 0x00 0xfe002000 0x00 0x1000 0x00 0xff800000 0x00 0x1000 0x00 0xfe000000 0x00 0x1000 0x00 0xfe002000 0x00 0x1000>;
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x90 0x04 0x00 0x91 0x04 0x00 0x92 0x04>;
		interrupt-names = "GPU\0MMU\0JOB";
		num_of_pp = <0x04>;
		sc_mpp = <0x01>;
		tbl = <0x05 0x06 0x07 0x08 0x09 0x09>;
		operating-points-v2 = <0x0a>;
		power-domains = <0x0b 0x1b>;
		system-coherency = <0x00>;
		clocks = <0x0c 0x8a>;
		clock-names = "gpu_mux";
		assigned-clocks = <0x0c 0x84 0x0c 0x86 0x0c 0x8a>;
		assigned-clock-parents = <0x0c 0x0f 0x00 0x0c 0x86>;
		assigned-clock-rates = <0x00 0x2faf0800 0x00>;
		phandle = <0x8a>;

		clk125_cfg {
			clk_freq = <0x7735940>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			clk_reg = <0xa03>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x1e 0x78>;
		};

		dvfs250_cfg {
			clk_freq = <0xee6b280>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			clk_reg = <0xa01>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x00 0x4c>;
			phandle = <0x05>;
		};

		dvfs285_cfg {
			clk_freq = <0x1107a76d>;
			clk_parent = "fclk_div7";
			clkp_freq = <0x1107a76d>;
			clk_reg = <0xe00>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x00 0x4c>;
		};

		dvfs400_cfg {
			clk_freq = <0x17d78400>;
			clk_parent = "fclk_div5";
			clkp_freq = <0x17d78400>;
			clk_reg = <0xc00>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x98 0xcf>;
			phandle = <0x06>;
		};

		dvfs500_cfg {
			clk_freq = <0x1dcd6500>;
			clk_parent = "fclk_div4";
			clkp_freq = <0x1dcd6500>;
			clk_reg = <0xa00>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x26 0xc2>;
			phandle = <0x07>;
		};

		dvfs666_cfg {
			clk_freq = <0x27bc86aa>;
			clk_parent = "fclk_div3";
			clkp_freq = <0x27bc86aa>;
			clk_reg = <0x800>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x96 0xcb>;
			phandle = <0x08>;
		};

		dvfs800_cfg {
			clk_freq = <0x2faf0800>;
			clk_parent = "fclk_div2p5";
			clkp_freq = <0x2faf0800>;
			clk_reg = <0x600>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0xe6 0xff>;
			phandle = <0x09>;
		};

		dvfs850_cfg {
			clk_freq = <0x326cef80>;
			clk_parent = "gp0_pll";
			clkp_freq = <0x326cef80>;
			clk_reg = <0x200>;
			voltage = <0x47e>;
			keep_count = <0x05>;
			threshold = <0x9c 0xff>;
		};

		reset_cfg {
			reg_level = <0x11>;
			reg_mask = <0x21>;
			reg_bit = <0x02>;
		};

		capb_reset {
			reg_level = <0x11>;
			reg_mask = <0x21>;
			reg_bit = <0x01>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0d>;
				};

				core1 {
					cpu = <0x0e>;
				};

				core2 {
					cpu = <0x0f>;
				};

				core3 {
					cpu = <0x10>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x11>;
				};

				core1 {
					cpu = <0x12>;
				};

				core2 {
					cpu = <0x13>;
				};

				core3 {
					cpu = <0x14>;
				};
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a73\0arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x15 0x16>;
			clocks = <0x0c 0x19 0x0c 0x18 0x0c 0x03>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent";
			operating-points-v2 = <0x17>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x226>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x18>;
			phandle = <0x0d>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a73\0arm,armv8";
			reg = <0x00 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x15 0x16>;
			clocks = <0x0c 0x19 0x0c 0x18 0x0c 0x03>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent";
			operating-points-v2 = <0x17>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x226>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x18>;
			phandle = <0x0e>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a73\0arm,armv8";
			reg = <0x00 0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x15 0x16>;
			clocks = <0x0c 0x19 0x0c 0x18 0x0c 0x03>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent";
			operating-points-v2 = <0x17>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x226>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x18>;
			phandle = <0x0f>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a73\0arm,armv8";
			reg = <0x00 0x03>;
			enable-method = "psci";
			cpu-idle-states = <0x15 0x16>;
			clocks = <0x0c 0x19 0x0c 0x18 0x0c 0x03>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent";
			operating-points-v2 = <0x17>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x226>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x18>;
			phandle = <0x10>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x15 0x16>;
			clocks = <0x0c 0x17 0x0c 0x16 0x0c 0x15>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent";
			operating-points-v2 = <0x19>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x278>;
			dynamic-power-coefficient = <0x6e>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x1a>;
			cpu_reg_use_buck;
			phandle = <0x11>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x101>;
			enable-method = "psci";
			cpu-idle-states = <0x15 0x16>;
			clocks = <0x0c 0x17 0x0c 0x16 0x0c 0x15>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent";
			operating-points-v2 = <0x19>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x278>;
			dynamic-power-coefficient = <0x6e>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x1a>;
			cpu_reg_use_buck;
			phandle = <0x12>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x102>;
			enable-method = "psci";
			cpu-idle-states = <0x15 0x16>;
			clocks = <0x0c 0x17 0x0c 0x16 0x0c 0x15>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent";
			operating-points-v2 = <0x19>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x278>;
			dynamic-power-coefficient = <0x6e>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x1a>;
			cpu_reg_use_buck;
			phandle = <0x13>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x103>;
			enable-method = "psci";
			cpu-idle-states = <0x15 0x16>;
			clocks = <0x0c 0x17 0x0c 0x16 0x0c 0x15>;
			clock-names = "core_clk\0low_freq_clk_parent\0high_freq_clk_parent";
			operating-points-v2 = <0x19>;
			voltage-tolerance = <0x00>;
			clock-latency = <0xc350>;
			capacity-dmips-mhz = <0x278>;
			dynamic-power-coefficient = <0x6e>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x1a>;
			cpu_reg_use_buck;
			phandle = <0x14>;
		};

		idle-states {
			entry-method = "arm,psci-0.2";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0xfa0>;
				exit-latency-us = <0x1388>;
				min-residency-us = <0x2710>;
				phandle = <0x15>;
			};

			system-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00>;
				entry-latency-us = <0x3fffffff>;
				exit-latency-us = <0x40000000>;
				min-residency-us = <0xffffffff>;
				phandle = <0x16>;
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
	};

	timer_bc {
		reg = <0x00 0xfe0100d8 0x00 0x04 0x00 0xfe0100dc 0x00 0x04>;
		timer_name = "Meson TimerD";
		clockevent-rating = <0x12c>;
		clockevent-shift = <0x14>;
		clockevent-features = <0x23>;
		interrupts = <0x00 0x03 0x01>;
		bit_enable = <0x07>;
		bit_mode = <0x06>;
		bit_resolution = <0x00>;
		resolution_1us = <0x01>;
		min_delta_ns = <0x0a>;
	};

	pmu-a73 {
		compatible = "arm,cortex-a73-pmu";
		private-interrupts;
		interrupts = <0x00 0x109 0x04 0x00 0x10a 0x04 0x00 0x10b 0x04 0x00 0x10c 0x04>;
		interrupt-affinity = <0x0d 0x0e 0x0f 0x10>;
	};

	pmu-a53 {
		compatible = "arm,cortex-a53-pmu";
		private-interrupts;
		interrupts = <0x00 0xe9 0x04 0x00 0xea 0x04 0x00 0xeb 0x04 0x00 0xec 0x04>;
		interrupt-affinity = <0x11 0x12 0x13 0x14>;
	};

	interrupt-controller@fff01000 {
		compatible = "arm,cortex-a15-gic\0arm,cortex-a9-gic";
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		interrupt-controller;
		reg = <0x00 0xfff01000 0x00 0x1000 0x00 0xfff02000 0x00 0x100>;
		interrupts = <0x01 0x09 0xf04>;
		phandle = <0x01>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	pm {
		compatible = "amlogic, pm";
		status = "okay";
		device_name = "aml_pm";
		reg = <0x00 0xfe010288 0x00 0x04 0x00 0xfe0102dc 0x00 0x04>;
	};

	aml_reboot {
		compatible = "aml, reboot";
		sys_reset = <0x84000009>;
		sys_poweroff = <0x84000008>;
		dis_nb_cpus_in_shutdown;
	};

	secmon {
		compatible = "amlogic, secmon";
		memory-region = <0x1b>;
		in_base_func = <0x82000020>;
		out_base_func = <0x82000021>;
		reserve_mem_size = <0x3300000>;
		clear_range = <0x5100000 0x2a00000>;
	};

	cma_shrinker {
		compatible = "amlogic, cma-shrinker";
		status = "disabled";
		adj = <0x00 0x64 0xc8 0xfa 0x384 0x3b6>;
		free = <0x2000 0x3000 0x4000 0x6000 0x7000 0x8000>;
	};

	xtal-clk {
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "xtal";
		#clock-cells = <0x00>;
		phandle = <0x22>;
	};

	cpu_info {
		compatible = "amlogic, cpuinfo";
		status = "okay";
		cpuinfo_cmd = <0x82000044>;
	};

	rtc@0xfe010288 {
		compatible = "amlogic,meson-vrtc";
		reg = <0x00 0xfe010288 0x00 0x04>;
	};

	power-domains {
		compatible = "amlogic,t7-power-domain";
		#power-domain-cells = <0x01>;
		status = "okay";
		phandle = <0x0b>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		acenna_reserved {
			compatible = "shared-dma-pool";
			size = <0x00 0xb000000>;
			reusable;
			phandle = <0x1c>;
		};

		ramoops@0x08400000 {
			compatible = "ramoops";
			reg = <0x00 0x8400000 0x00 0x100000>;
			record-size = <0x20000>;
			console-size = <0x40000>;
			ftrace-size = <0x80000>;
			pmsg-size = <0x20000>;
		};

		linux,secmon {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x3400000>;
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x5000000 0x00 0x3400000>;
			clear-map;
			phandle = <0x1b>;
		};

		linux,dsp_fw {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x1000000>;
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x1000000>;
			phandle = <0x1f>;
		};

		linux,meson-fb {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x800000>;
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x3f800000 0x00 0x800000>;
			phandle = <0x64>;
		};

		linux,codec_mm_cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0xbc00000>;
			alignment = <0x00 0x400000>;
			linux,contiguous-region;
			clear-map;
			alloc-ranges = <0x00 0x00 0x40000000 0x40000000>;
			phandle = <0x8b>;
		};

		linux,di_cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x00>;
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x40000000 0x40000000>;
			phandle = <0x8d>;
		};

		linux,ppmgr {
			compatible = "shared-dma-pool";
			size = <0x00 0x00>;
			alloc-ranges = <0x00 0x00 0x40000000 0x40000000>;
			phandle = <0x9d>;
		};

		linux,isp_cma {
			compatible = "shared-dma-pool";
			reusable;
			status = "okay";
			size = <0x00 0xf800000>;
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x40000000 0x40000000>;
			phandle = <0x57>;
		};

		linux,adapt_cma {
			compatible = "shared-dma-pool";
			reusable;
			status = "okay";
			size = <0x00 0x00>;
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x40000000 0x40000000>;
			phandle = <0x58>;
		};

		linux,ion-dev {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x5000000>;
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x40000000 0x40000000>;
			phandle = <0x62>;
		};

		linux,ion-camera {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x3c00000>;
			alignment = <0x00 0x400000>;
			alloc-ranges = <0x00 0x00 0x40000000 0x40000000>;
			phandle = <0x63>;
		};

		linux,codec_mm_reserved {
			compatible = "amlogic, codec-mm-reserved";
			size = <0x00 0x00>;
			alignment = <0x00 0x100000>;
			alloc-ranges = <0x00 0x00 0x40000000 0x40000000>;
			phandle = <0x8c>;
		};
	};

	nna_top_ports_wrapper@fe370000 {
		compatible = "amazon,nna-1.0";
		device-name = "acenna0";
		status = "okay";
		clocks = <0x0c 0x154>;
		clock-names = "nna_clk_gate";
		assigned-clocks = <0x0c 0x14d 0x0c 0x153 0x0c 0x154>;
