				phandle = <0xa0>;
			};

			amazon,k1 {
				label = "volup";
				linux,code = <0x73>;
				phandle = <0xa2>;
			};

			amazon,k2 {
				label = "power";
				linux,code = <0x74>;
				phandle = <0xa4>;
			};
		};

		amazon,key-profiles {

			amazon,p0 {
				label = "default";
				amazon,key-map = <0x9f 0xa0 0xa1 0xa2 0xa3 0xa4>;
			};

			amazon,p1 {
				label = "landscape";
				amazon,key-map = <0x9f 0xa2 0xa1 0xa0 0xa3 0xa4>;
			};

			amazon,p2 {
				label = "portrait";
