			};
		};

		amazon,key-profiles-fixup {
			amazon,idme-name = "productid2";
			amazon,idme-value = "volume-keys=chevrons";
		};
	};

	keycombo@0 {
		compatible = "amazon,keycombo";
		keys_down = "KEY_VOLUMEDOWN\0KEY_POWER";
		keys_down_delay = <0x2328>;
		keys_down_func = <0x00>;
